---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Photo Delivery">
  <div class="hero bg-base-200 min-h-screen">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-5xl font-bold">Kenneth Yang <br /> Photo Delivery</h1>
        <p class="py-6">
          Enter the code Kenneth gave you below to view your photos:
        </p>

        <input type="text" placeholder="Your code here..." class="input" />

        <button class="btn btn-primary">Submit</button>
      </div>
    </div>
  </div>
</MainLayout>
